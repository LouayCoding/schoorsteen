# Mail gaat via de mailserver op de VPS (zelfde netwerk als de site).
SMTP_HOST=autodokter-mail
SMTP_PORT=25
MAIL_FROM=info@directschoorsteenvegen.nl
MAIL_TO=info@directschoorsteenvegen.nl
# Alleen nodig als de mailserver authenticatie eist (poort 587).
# SMTP_USER=info@directschoorsteenvegen.nl
# SMTP_PASS=

# Optioneel: Google Ads tag-ID (AW-XXXXXXXXX). Moet als *build*-variabele in Coolify staan.
# Leeg laten als de Ads-conversietag via GTM loopt (aanbevolen).
NEXT_PUBLIC_GOOGLE_ADS_ID=
